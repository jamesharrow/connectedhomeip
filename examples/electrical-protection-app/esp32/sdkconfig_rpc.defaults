#
#    Description:
#      Configuration for enabling Pigweed RPC.
#

CONFIG_ENABLE_PW_RPC=y
CONFIG_EXAMPLE_UART_PORT_NUM=0
CONFIG_ENABLE_CHIP_SHELL=n

# Disable lwIP mDNS
CONFIG_LWIP_DNS=n

# Use a custom partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Serial Flasher config
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# Enable OTA Requestor
CONFIG_ENABLE_OTA_REQUESTOR=y

CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

CONFIG_ESP_SYSTEM_CHECK_INT_LEVEL_4=n

# These options conflict with pigweed and should be disabled
CONFIG_ESP_ERR_TO_NAME_LOOKUP=n

CONFIG_LOG_DEFAULT_LEVEL_DEBUG=y

CONFIG_FREERTOS_ENABLE_BACKWARD_COMPATIBILITY=n
