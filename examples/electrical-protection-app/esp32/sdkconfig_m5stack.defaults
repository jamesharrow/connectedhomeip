#    Description:
#      Configuration for using this demo with an M5Stack ESP32 device.
#

# Default to 921600 baud when flashing and monitoring device
CONFIG_ESPTOOLPY_BAUD_921600B=y
CONFIG_ESPTOOLPY_BAUD=921600
CONFIG_ESPTOOLPY_COMPRESSED=y

# Disable shell support
CONFIG_ENABLE_CHIP_SHELL=n

CONFIG_DISPLAY_TYPE_M5STACK=y
CONFIG_HAVE_DISPLAY=y

# M5Stack uses custom display driver
CONFIG_USE_JTAG=n

CONFIG_TFT_PREDEFINED_DISPLAY_TYPE=3
CONFIG_EXAMPLE_LCD_BK_LIGHT_ON_LEVEL=1
CONFIG_EXAMPLE_LCD_BK_LIGHT_OFF_LEVEL=0
